#include <limits.h>
#include <stdlib.h>

int divide(int dividend, int divisor)
{
    if (dividend == INT_MIN && divisor == -1)
        return INT_MAX;

    long long dvd = labs((long)dividend);
    long long dvs = labs((long)divisor);
    long long ans = 0;

    int sign = ((dividend < 0) ^ (divisor < 0)) ? -1 : 1;

    while (dvd >= dvs) {
        long long temp = dvs;
        long long m = 1;

        while ((temp << 1) <= dvd) {
            temp <<= 1;
            m <<= 1;
        }

        dvd -= temp;
        ans += m;
    }

    if (sign < 0)
        return (int)(-ans);

    return (int)ans;
}
